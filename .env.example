# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to GitHub!

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/zynk_appointments

# Security Keys (Generate your own!)
SESSION_SECRET=your_session_secret_here
JWT_SECRET=your_jwt_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Application Environment
NODE_ENV=development

# Push Notification Keys (Generate your own VAPID keys)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Email Configuration (Use encrypted credentials instead!)
# Note: Don't use these variables directly anymore - use the secure credential system
# EMAIL_USER=your_gmail_address@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password

# Credential Encryption Key (Generated automatically by setup-credentials.js)
# CREDENTIAL_ENCRYPTION_KEY=will_be_generated_automatically