<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Synkrone</title>
  <link rel="stylesheet" href="/stylesheets/login.css" />
</head>
<body>
  <div class="login-container">
    <div class="login-box">
      <img src="/images/logo.png" alt="logo" class="logo" />
      <h1>Create Your Account</h1>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form action="/register" method="post">
        <input type="text" name="username" placeholder="Username" required value="<%= formData?.username || '' %>" />
        <input type="text" name="fullname" placeholder="Full Name" required value="<%= formData?.fullname || '' %>" />
        <input type="email" name="email" placeholder="Email" required value="<%= formData?.email || '' %>" />
        <input type="password" name="password" placeholder="Password" required />
        <input type="password" name="confirmPassword" placeholder="Confirm Password" required />
        <div class="role-toggle" style="margin:15px 0; display:flex; gap:20px; align-items:center; justify-content:center; background:#f8f9fa; padding:15px; border-radius:8px;">
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-weight:500; color: #757575">
            <input type="radio" name="role" value="user" checked style="margin:0;"/> Patient
          </label>
          <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-weight:500; color: #757575">
            <input type="radio" name="role" value="doctor" style="margin:0;"/> Doctor
          </label>
        </div>
        <div id="doctorFields" style="display:none; margin-top:10px;">
          <input type="text" name="specialization" placeholder="Specialization" style="margin-bottom:10px;"/>
          <select name="hospitalId" id="hospitalIdReg" style="width:100%; padding:12px; border:1px solid #ddd; border-radius:5px;">
            <option value="">Select hospital</option>
          </select>
        </div>
        <button type="submit" class="btn" style="margin-top: 8px;">Register</button>
      </form>

      <div class="divider" style="text-align: center; margin: 20px 0; position: relative;">
        <span style="background: white; padding: 0 15px; color: #666;">OR</span>
        <hr style="position: absolute; top: 50%; left: 0; right: 0; z-index: -1; border: none; border-top: 1px solid #ddd;">
      </div>

      <a href="/auth/google" class="google-btn" style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; text-decoration: none; color: #333; background: white; margin-bottom: 20px; transition: background-color 0.3s;">
        <svg width="18" height="18" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Register with Google
      </a>

      <div class="links">
        <p>Already have an account? <a href="/login">Login</a></p>
      </div>
    </div>
  </div>
<script>
  document.addEventListener('DOMContentLoaded', async function() {
    const radios = document.querySelectorAll('input[name=role]');
    const doctorFields = document.getElementById('doctorFields');
    const hospitalSelect = document.getElementById('hospitalIdReg');
    function sync() {
      const val = document.querySelector('input[name=role]:checked').value;
      doctorFields.style.display = val === 'doctor' ? 'block' : 'none';
    }
    radios.forEach(r => r.addEventListener('change', sync));
    sync();
    try {
      const res = await fetch('/api/hospitals');
      const data = await res.json();
      (data.hospitals || []).forEach(h => {
        const opt = document.createElement('option');
        opt.value = h._id; opt.textContent = `${h.name} (${h.location})`;
        hospitalSelect.appendChild(opt);
      });
    } catch(_) {}
  });
</script>
</body>
</html>