<!DOCTYPE html>
<html>
  <head>
    <title>Appointment Confirmed - Zynk</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f4f4f9;
        margin: 0;
        padding: 0;
        animation: fadeIn 1s ease-in-out;
      }
      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      .app-container {
        display: flex;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0;
      }
      .sidebar {
        width: 250px;
        background-color: #fff;
        padding: 20px;
        border-right: 1px solid #e1e1e1;
        position: relative;
      }
      .logo {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }
      .logo i {
        font-size: 28px;
        color: #007bff;
        margin-right: 10px;
      }
      .logo h1 {
        font-size: 24px;
        color: #333;
        margin: 0;
      }
      .subtitle {
        font-size: 14px;
        color: #777;
        margin-bottom: 20px;
      }
      nav a {
        display: flex;
        align-items: center;
        padding: 10px 15px;
        color: #333;
        text-decoration: none;
        border-radius: 4px;
        transition: background-color 0.3s ease;
      }
      nav a:hover {
        background-color: #f1f1f1;
      }
      nav a i {
        margin-right: 10px;
      }
      .main-content {
        flex: 1;
        padding: 20px;
      }
      .confirmation-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 20px;
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
      }
      .success-icon {
        font-size: 50px;
        color: #28a745;
        margin-bottom: 20px;
      }
      h1 {
        color: #333;
        font-size: 28px;
        margin-bottom: 10px;
      }
      .confirmation-message {
        margin: 20px 0;
        font-size: 18px;
        color: #555;
      }
      .appointment-details {
        text-align: left;
        margin: 20px 0;
      }
      .detail-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
      }
      .detail-item i {
        font-size: 18px;
        color: #007bff;
        margin-right: 10px;
      }
      .action-buttons {
        display: flex;
        justify-content: center;
        gap: 10px;
      }
      .btn-primary, .btn-secondary {
        display: inline-block;
        padding: 10px 20px;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
        transition: background-color 0.3s ease;
      }
      .btn-primary {
        background-color: #007bff;
      }
      .btn-primary:hover {
        background-color: #0056b3;
      }
      .btn-secondary {
        background-color: #6c757d;
      }
      .btn-secondary:hover {
        background-color: #5a6268;
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <aside class="sidebar">
        <div class="logo">
          <i class="bi bi-calendar-check"></i>
          <h1>Synkrone</h1>
        </div>
        <p class="subtitle">Smart Appointment Scheduling</p>
        <nav>
          <a href="/"><i class="bi bi-house"></i> Dashboard</a>
          <a href="/appointments"><i class="bi bi-calendar-event"></i> Appointments</a>
          <a href="/insights"><i class="bi bi-lightning"></i> AI Insights</a>
          <a href="/settings"><i class="bi bi-gear"></i> Settings</a>
        </nav>
      </aside>

      <main class="main-content">
        <div class="confirmation-container">
          <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
          </div>
          <h1>Appointment Confirmed!</h1>
          <p class="confirmation-message">Your appointment has been successfully scheduled.</p>
          
          <div class="appointment-details">
            <h3>Appointment Details</h3>
            <div class="detail-item">
              <i class="bi bi-person-fill"></i>
              <span>Name: <%= appointmentData.name %></span>
            </div>
            <div class="detail-item">
              <i class="bi bi-telephone-fill"></i>
              <span>Phone: <%= appointmentData.phone %></span>
            </div>
            <div class="detail-item">
              <i class="bi bi-calendar-date"></i>
              <span>Date: <%= appointmentData.date %></span>
            </div>
            <div class="detail-item">
              <i class="bi bi-clock"></i>
              <span>Time: <%= appointmentData.time %></span>
            </div>
            <div class="detail-item">
              <i class="bi bi-bookmark-fill"></i>
              <span>Type: <%= appointmentData.type.charAt(0).toUpperCase() + appointmentData.type.slice(1) %></span>
            </div>
          </div>

          <div class="action-buttons">
            <a href="/" class="btn-primary">
              <i class="bi bi-house"></i>
              Back to Dashboard
            </a>
            <a href="/appointments" class="btn-secondary">
              <i class="bi bi-calendar-event"></i>
              View All Appointments
            </a>
          </div>
        </div>
        
        <!-- Email Notification Opt-in Section -->
        <div class="confirmation-container" style="margin-top: 20px;">
          <h3>📧 Email Notifications</h3>
          <p>Would you like to receive email confirmations and reminders for this appointment?</p>
          
          <form id="emailOptInForm" style="margin: 20px 0;">
            <div style="margin: 15px 0;">
              <label style="display: flex; align-items: center; cursor: pointer;">
                <input type="checkbox" id="emailOptIn" style="margin-right: 10px; transform: scale(1.2);">
                <span>Yes, send me email notifications</span>
              </label>
            </div>
            
            <div id="emailBenefits" style="background: #f8f9fa; padding: 15px; border-radius: 6px; margin: 15px 0; font-size: 14px;">
              <strong>You will receive:</strong>
              <ul style="margin: 10px 0; padding-left: 20px;">
                <li>✅ Immediate confirmation email with all appointment details</li>
                <li>🗓️ Reminder email 1 day before your appointment</li>
                <li>⏰ Reminder email 12 hours before your appointment</li>
                <li>🚨 Reminder email 1 hour before your appointment</li>
              </ul>
            </div>
            
            <button type="submit" class="btn-primary" style="background: #28a745; border: none; padding: 12px 24px; border-radius: 6px; cursor: pointer;">
              <i class="bi bi-envelope-check"></i>
              Enable Email Notifications
            </button>
          </form>
          
          <div id="emailStatus" style="margin-top: 15px; padding: 10px; border-radius: 6px; display: none;"></div>
        </div>
        
        <!-- Email Testing Section - FOR DEVELOPMENT -->
        <div class="confirmation-container" style="margin-top: 20px; border: 2px dashed #ffc107; background: #fff9e6;">
          <h3>🧪 Email Testing (Development Only)</h3>
          <p style="color: #856404; font-size: 14px; margin-bottom: 20px;">
            <strong>⚠️ Testing Tools:</strong> Use these buttons to test email notifications before going live.
          </p>
          
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin: 20px 0;">
            
            <div style="text-align: center;">
              <button type="button" class="test-email-btn" data-type="confirmation" 
                      style="background: #007bff; color: white; border: none; padding: 12px 16px; border-radius: 6px; cursor: pointer; width: 100%; margin-bottom: 8px;">
                <i class="bi bi-envelope-check"></i><br>
                Test Confirmation Email
              </button>
              <small style="color: #666; font-size: 12px;">Tests the immediate confirmation email with all appointment details</small>
            </div>
            
            <div style="text-align: center;">
              <button type="button" class="test-email-btn" data-type="oneDayBefore" 
                      style="background: #28a745; color: white; border: none; padding: 12px 16px; border-radius: 6px; cursor: pointer; width: 100%; margin-bottom: 8px;">
                <i class="bi bi-calendar-date"></i><br>
                Test 1-Day Reminder
              </button>
              <small style="color: #666; font-size: 12px;">Tests the reminder sent 1 day before appointment</small>
            </div>
            
            <div style="text-align: center;">
              <button type="button" class="test-email-btn" data-type="twelveHoursBefore" 
                      style="background: #ffc107; color: #212529; border: none; padding: 12px 16px; border-radius: 6px; cursor: pointer; width: 100%; margin-bottom: 8px;">
                <i class="bi bi-clock"></i><br>
                Test 12-Hour Reminder
              </button>
              <small style="color: #666; font-size: 12px;">Tests the reminder sent 12 hours before appointment</small>
            </div>
            
            <div style="text-align: center;">
              <button type="button" class="test-email-btn" data-type="oneHourBefore" 
                      style="background: #dc3545; color: white; border: none; padding: 12px 16px; border-radius: 6px; cursor: pointer; width: 100%; margin-bottom: 8px;">
                <i class="bi bi-alarm"></i><br>
                Test 1-Hour Reminder
              </button>
              <small style="color: #666; font-size: 12px;">Tests the urgent reminder sent 1 hour before appointment</small>
            </div>
            
          </div>
          
          <div id="testEmailStatus" style="margin-top: 15px; padding: 12px; border-radius: 6px; display: none; font-size: 14px;"></div>
          
          <div style="background: #e9ecef; padding: 15px; border-radius: 6px; margin-top: 15px; font-size: 13px; color: #495057;">
            <strong>📧 Email Testing Instructions:</strong>
            <ul style="margin: 8px 0 0 20px; padding: 0;">
              <li>Each button sends a test email to: <strong><%= user?.email || 'your registered email' %></strong></li>
              <li>Check your email inbox (and spam folder) after clicking each button</li>
              <li>Test emails use real appointment data but won't affect reminder scheduling</li>
              <li>Remove this section in production by setting NODE_ENV=production</li>
            </ul>
          </div>
        </div>
      </main>
    </div>
    
    <script>
      // Email opt-in form handling
      document.getElementById('emailOptInForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const checkbox = document.getElementById('emailOptIn');
        const statusDiv = document.getElementById('emailStatus');
        const submitButton = this.querySelector('button[type="submit"]');
        
        if (!checkbox.checked) {
          statusDiv.style.display = 'block';
          statusDiv.style.background = '#fff3cd';
          statusDiv.style.color = '#856404';
          statusDiv.innerHTML = '⚠️ Please check the box to enable email notifications.';
          return;
        }
        
        // Show loading state
        submitButton.disabled = true;
        submitButton.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Enabling...';
        
        try {
          const response = await fetch('/api/appointments/enable-email-notifications', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              appointmentId: '<%= appointmentData._id %>'
            })
          });
          
          const result = await response.json();
          
          statusDiv.style.display = 'block';
          if (result.success) {
            statusDiv.style.background = '#d4edda';
            statusDiv.style.color = '#155724';
            statusDiv.innerHTML = '✅ Email notifications enabled! Check your email for confirmation.';
            submitButton.style.display = 'none';
            checkbox.disabled = true;
          } else {
            statusDiv.style.background = '#f8d7da';
            statusDiv.style.color = '#721c24';
            statusDiv.innerHTML = '❌ ' + (result.error || 'Failed to enable email notifications.');
            submitButton.disabled = false;
            submitButton.innerHTML = '<i class="bi bi-envelope-check"></i> Enable Email Notifications';
          }
        } catch (error) {
          statusDiv.style.display = 'block';
          statusDiv.style.background = '#f8d7da';
          statusDiv.style.color = '#721c24';
          statusDiv.innerHTML = '❌ Network error. Please try again.';
          submitButton.disabled = false;
          submitButton.innerHTML = '<i class="bi bi-envelope-check"></i> Enable Email Notifications';
        }
      });

      // Test email button handlers
      document.querySelectorAll('.test-email-btn').forEach(button => {
        button.addEventListener('click', async function() {
          const emailType = this.getAttribute('data-type');
          const statusDiv = document.getElementById('testEmailStatus');
          const originalContent = this.innerHTML;
          
          // Show loading state
          this.disabled = true;
          this.innerHTML = '<i class="bi bi-arrow-clockwise"></i><br>Sending...';
          
          try {
            const response = await fetch(`/api/appointments/test-email/${emailType}`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                appointmentId: '<%= appointmentData._id %>'
              })
            });
            
            const result = await response.json();
            
            statusDiv.style.display = 'block';
            if (result.success) {
              statusDiv.style.background = '#d4edda';
              statusDiv.style.color = '#155724';
              statusDiv.style.border = '1px solid #c3e6cb';
              statusDiv.innerHTML = `
                <strong>✅ ${result.message}</strong><br>
                <small>Sent to: ${result.sentTo}<br>
                Message ID: ${result.messageId}</small>
              `;
            } else {
              statusDiv.style.background = '#f8d7da';
              statusDiv.style.color = '#721c24';
              statusDiv.style.border = '1px solid #f5c6cb';
              statusDiv.innerHTML = `❌ ${result.error}`;
            }
          } catch (error) {
            statusDiv.style.display = 'block';
            statusDiv.style.background = '#f8d7da';
            statusDiv.style.color = '#721c24';
            statusDiv.style.border = '1px solid #f5c6cb';
            statusDiv.innerHTML = '❌ Network error. Please try again.';
          } finally {
            // Restore button state
            this.disabled = false;
            this.innerHTML = originalContent;
          }
        });
      });
    </script>
    
    <script src="/javascripts/push.js"></script>
    <script>
      document.getElementById('enable-notifications').addEventListener('click', function() {
        if (window.pushNotifications && window.pushNotifications.enable) window.pushNotifications.enable();
      });
    </script>
  </body>
</html>