<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/stylesheets/homepage.css">
</head>
<body>
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <h1>Welcome to Synkrone</h1>
      <div style="display: flex; gap: 0.5rem;">
        <button id="dark-mode-toggle-btn" title="Enable dark mode" aria-label="Toggle dark mode" aria-pressed="false" style="padding: 0.5rem 1rem; background: #007bff; color: white; border: 2px solid white; border-radius: 4px; cursor: pointer; font-weight: bold;">
          <i class="bi bi-moon" style="margin-right: 0.5rem;"></i>Dark Mode
        </button>
        <button id="high-contrast-toggle-btn" title="Enable high-contrast mode" aria-label="Toggle high-contrast mode" aria-pressed="false" style="padding: 0.5rem 1rem; 
        background: #007bff; color: white; border: 2px solid white; border-radius: 4px; cursor: pointer; font-weight: bold;">
          <i class="bi bi-eye" style="margin-right: 0.5rem;"></i>High Contrast
        </button>
      </div>
    </div>
    <p>Smart appointment scheduling for doctors and patients.</p>
    <div class="buttons">
      <a href="/login" class="btn">Login</a>
      <a href="/register" class="btn">Register</a>
    </div>
  </div>
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
  <script src="/javascripts/dark-mode.js"></script>
  <script src="/javascripts/high-contrast.js"></script>
</body>
</html>