<!DOCTYPE html>
<html>
<head>
    <title>Appointments - Zynk</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/appoitments.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="patient-sidebar appointments-sidebar">
            <div class="sidebar-header">
                <div class="logo-container">
                    <div class="logo-icon">
                        <img src="/images/logo.png" alt="Logo" class="logo-image">
                    </div>
                    <div class="logo-text">
                        <h1>Synkrone</h1>
                        <span>Appointments</span>
                    </div>
                </div>
            </div>
            
            <nav class="patient-nav">
                <a href="/" class="nav-item">
                    <i class="bi bi-house"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/appointments" class="nav-item active">
                    <i class="bi bi-calendar-event"></i>
                    <span>Appointments</span>
                </a>
                <a href="/logout" class="nav-item">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
                <% /* Patient portal: hide AI Insights and Doctor Portal links */ %>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Header -->
            <header class="page-header">
                <div>
                    <h1>Appointments</h1>
                    <p>Manage all your appointments</p>
                </div>
                <div class="header-actions">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" id="searchInput" placeholder="Search...">
                    </div>
                    <a href="/dashboard" class="btn-primary">
                        <i class="bi bi-plus"></i>
                        New
                    </a>
                </div>
                <button class="quick-action-btn" id="dark-mode-toggle-btn" title="Enable dark mode" aria-label="Toggle dark mode" aria-pressed="false">
                    <i class="bi bi-moon"></i>
                    DARK
                  </button>  
                  <button class="quick-action-btn" id="high-contrast-toggle-btn" title="Enable high-contrast mode" aria-label="Toggle high-contrast mode" aria-pressed="false">
                    <i class="bi bi-eye"></i>
                    High Contrast
                  </button>
            </header>

            <!-- Stats -->
            <div class="stats">
                <div class="stat-card">
                    <div class="stat-icon total">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= stats.total %></div>
                        <div class="stat-label">Total</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon pending">
                        <i class="bi bi-clock"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= stats.pending %></div>
                        <div class="stat-label">Pending</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon completed">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= stats.completed %></div>
                        <div class="stat-label">Completed</div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon cancelled">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div>
                        <div class="stat-number"><%= stats.cancelled %></div>
                        <div class="stat-label">Cancelled</div>
                    </div>
                </div>
            </div>

            <div class="filters" role="region" aria-label="Appointment filters">
                <div class="filter-group" role="tablist" aria-label="Appointment status tabs">
                    <button class="filter-btn" role="tab" data-filter="all" aria-selected="false" id="tab-all" aria-controls="appointments-grid">All</button>
                    <button class="filter-btn" role="tab" data-filter="pending" aria-selected="false" id="tab-pending" aria-controls="appointments-grid">Pending</button>
                    <button class="filter-btn" role="tab" data-filter="completed" aria-selected="false" id="tab-completed" aria-controls="appointments-grid">Completed</button>
                    <button class="filter-btn" role="tab" data-filter="cancelled" aria-selected="false" id="tab-cancelled" aria-controls="appointments-grid">Cancelled</button>
                </div>
            </div>

            <!-- Appointments Grid -->
            <div class="appointments-grid" id="appointments-grid" role="region" aria-live="polite">
                <% if (appointments.length === 0) { %>
                    <div class="empty-state">
                        <i class="bi bi-calendar-x"></i>
                        <h3>No Appointments</h3>
                        <p>No appointments found</p>
                        <a href="/" class="btn-primary">Add First Appointment</a>
                    </div>
                <% } else { %>
                    <% appointments.forEach(function(appointment) { %>
                        <div class="appointment-card" 
                             data-status="<%= appointment.status || 'pending' %>"
                             data-name="<%= appointment.name.toLowerCase() %>"
                             data-phone="<%= appointment.phone %>">
                            
                            <div class="card-header">
                                <div class="patient-avatar">
                                    <span><%= appointment.name.charAt(0).toUpperCase() %></span>
                                </div>
                                <div class="status-badge <%= appointment.status || 'pending' %>">
                                    <%= (appointment.status || 'pending').charAt(0).toUpperCase() + (appointment.status || 'pending').slice(1) %>
                                </div>
                            </div>

                            <div class="card-body">
                                <h4><%= appointment.name %></h4>
                                <div class="appointment-info">
                                    <div class="info-item">
                                        <i class="bi bi-telephone"></i>
                                        <span><%= appointment.phone %></span>
                                    </div>
                                    <div class="info-item">
                                        <i class="bi bi-calendar"></i>
                                        <span><%= new Date(appointment.date).toLocaleDateString() %></span>
                                    </div>
                                    <div class="info-item">
                                        <i class="bi bi-clock"></i>
                                        <span><%= appointment.time %></span>
                                    </div>
                                </div>
                                <div class="type-badge <%= appointment.type %>">
                                    <%= appointment.type.charAt(0).toUpperCase() + appointment.type.slice(1) %>
                                </div>
                            </div>

                            <div class="card-actions">
                                <% if (!appointment.status || appointment.status === 'pending') { %>
                                    <button class="btn-small btn-secondary" onclick="editAppointment('<%= appointment._id %>')">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </button>
                                    <button class="btn-small btn-danger" onclick="cancelAppointment('<%= appointment._id %>')">
                                        <i class="bi bi-x-circle"></i>
                                        Cancel
                                    </button>
                                <% } else if (appointment.status === 'in-progress') { %>
                                    <button class="btn-small btn-secondary" onclick="viewAppointment('<%= appointment._id %>')">
                                        <i class="bi bi-eye"></i>
                                        View Details
                                    </button>
                                <% } else { %>
                                    <button class="btn-small btn-secondary" onclick="viewAppointment('<%= appointment._id %>')">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </button>
                                    <% if (appointment.status === 'cancelled' || appointment.status === 'completed') { %>
                                        <button class="btn-small btn-danger" onclick="deleteAppointment('<%= appointment._id %>')">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </main>
    </div>

    <script src="/javascripts/dark-mode.js"></script>
    <script src="/javascripts/high-contrast.js"></script>
    <script>
    // Tabs + Search + Filter logic
    (function () {
      // elements
      const tabButtons = Array.from(document.querySelectorAll('.filter-btn'));
      const searchInput = document.getElementById('searchInput');
      const cards = () => Array.from(document.querySelectorAll('.appointment-card'));
      const APPOINTMENTS_GRID_ID = 'appointments-grid';

      function setActiveTab(selectedBtn) {
        tabButtons.forEach(btn => {
          const isActive = btn === selectedBtn;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
          // keep tabindex so only active tab is tabbable (accessibility nicety)
          btn.tabIndex = isActive ? 0 : -1;
        });
      }

      //filter cards by status + search term
      function applyFilter(filter, searchTerm = '') {
        let visibleCount = 0;
        cards().forEach(card => {
          const status = (card.dataset.status || 'pending').toLowerCase();
          const name = (card.dataset.name || '').toLowerCase();
          const phone = (card.dataset.phone || '').toLowerCase();
          const matchesFilter = (filter === 'all') || (status === filter);
          const matchesSearch = !searchTerm || name.includes(searchTerm) || phone.includes(searchTerm);

          const shouldShow = matchesFilter && matchesSearch;
          card.style.display = shouldShow ? '' : 'none';
          if (shouldShow) visibleCount++;
        });

        // If no cards visible, show any existing empty-state message (or create one)
        const grid = document.getElementById(APPOINTMENTS_GRID_ID);
        const existingEmpty = grid.querySelector('.empty-state');
        if (visibleCount === 0) {
          if (!existingEmpty) {
            const emptyDiv = document.createElement('div');
            emptyDiv.className = 'empty-state';
            emptyDiv.innerHTML = '<i class="bi bi-calendar-x"></i><h3>No matching appointments</h3><p>No appointments found for this filter/search.</p>';
            grid.insertBefore(emptyDiv, grid.firstChild);
          } else {
            existingEmpty.style.display = '';
          }
        } else {
          if (existingEmpty) existingEmpty.style.display = 'none';
        }
      }

      // Apply tab selection (button click)
      function onTabSelect(btn, pushHistory = true) {
        const filter = (btn.dataset.filter || 'all').toLowerCase();
        setActiveTab(btn);
        const searchTerm = (searchInput.value || '').toLowerCase();
        applyFilter(filter, searchTerm);

        // Update URL hash to persist selection
        if (pushHistory) {
          try {
            history.replaceState(null, '', `#${filter}`);
          } catch (e) {
            // ignore if not allowed
          }
        }
      }

      // keyboard navigation for tabs (Left/Right, Home/End)
      tabButtons.forEach((btn, idx) => {
        btn.addEventListener('keydown', (e) => {
          const key = e.key;
          if (key === 'ArrowRight' || key === 'ArrowLeft' || key === 'Home' || key === 'End') {
            e.preventDefault();
            let nextIdx;
            if (key === 'ArrowRight') nextIdx = (idx + 1) % tabButtons.length;
            if (key === 'ArrowLeft') nextIdx = (idx - 1 + tabButtons.length) % tabButtons.length;
            if (key === 'Home') nextIdx = 0;
            if (key === 'End') nextIdx = tabButtons.length - 1;
            tabButtons[nextIdx].focus();
          }
          // Enter / Space to activate
          if (key === 'Enter' || key === ' ') {
            e.preventDefault();
            onTabSelect(btn);
          }
        });

        btn.addEventListener('click', () => onTabSelect(btn));
      });

      // Search updates live (keeps selected tab applied)
      searchInput.addEventListener('input', function () {
        const active = tabButtons.find(b => b.classList.contains('active')) || tabButtons[0];
        const filter = (active && active.dataset.filter) ? active.dataset.filter : 'all';
        applyFilter(filter.toLowerCase(), (this.value || '').toLowerCase());
      });

      // Initialize: choose tab from URL hash if present, else from .active, else first tab
      function init() {
        // match hash like #pending
        const hash = (window.location.hash || '').replace('#', '').toLowerCase();
        let initialBtn = tabButtons.find(b => b.dataset.filter === hash);
        if (!initialBtn) initialBtn = tabButtons.find(b => b.classList.contains('active')) || tabButtons[0];

        // ensure exactly one active
        setActiveTab(initialBtn);

        // apply filter according to initial tab and current search value
        applyFilter((initialBtn.dataset.filter || 'all').toLowerCase(), (searchInput.value || '').toLowerCase());

        // ensure only active tab is in tab order
        tabButtons.forEach(b => b.tabIndex = b.classList.contains('active') ? 0 : -1);
      }

      // run init on DOM ready (we're at bottom of page so safe)
      init();

      // Expose small helper for other actions (optional)
      window.__appointmentsFilter = {
        apply: (filter) => {
          const btn = tabButtons.find(b => b.dataset.filter === filter) || tabButtons[0];
          onTabSelect(btn);
        }
      };
    })();
    </script>

    <script>
        
        // Helper function to get JWT token from localStorage or cookies
        function getAuthToken() {
            // Try localStorage first
            const token = localStorage.getItem('token') || localStorage.getItem('jwt') || localStorage.getItem('authToken');
            if (token) return token;
            
            // Try cookies as fallback
            const cookies = document.cookie.split(';');
            for (let cookie of cookies) {
                const [name, value] = cookie.trim().split('=');
                if (name === 'token' || name === 'jwt' || name === 'authToken') {
                    return value;
                }
            }
            return null;
        }

        function cancelAppointment(id) {
            if (!confirm('Are you sure you want to cancel this appointment?')) return;
            
            const token = getAuthToken();
            const headers = { 'Content-Type': 'application/json' };
            
            // Add Authorization header if token exists
            if (token) {
                headers['Authorization'] = `Bearer ${token}`;
            }
            
            fetch(`/appointments/${id}/status`, {
                method: 'PUT',
                headers: headers,
                credentials: 'include', // Include cookies for session-based auth
                body: JSON.stringify({ status: 'cancelled' })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error cancelling appointment: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error cancelling appointment. Please try again.');
            });
        }

        function deleteAppointment(id) {
            if (!confirm('Permanently delete this appointment? This action cannot be undone.')) return;
            
            const token = getAuthToken();
            const headers = {};
            
            // Add Authorization header if token exists
            if (token) {
                headers['Authorization'] = `Bearer ${token}`;
            }
            
            fetch(`/appointments/${id}`, {
                method: 'DELETE',
                headers: headers,
                credentials: 'include' // Include cookies for session-based auth
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error deleting appointment: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error deleting appointment. Please try again.');
            });
        }

        function editAppointment(id) {
            // Redirect to dashboard with edit parameter
            window.location.href = `/?edit=${id}`;
        }

        function viewAppointment(id) {
            // For now, redirect to edit mode for viewing
            // In the future, this could open a modal with appointment details
            window.location.href = `/?view=${id}`;
        }

        // Legacy function kept for compatibility
        function updateStatus(id, status) {
            if (status === 'cancelled') {
                cancelAppointment(id);
                return;
            }
            
            if (status === 'cancelled' && !confirm('Cancel this appointment?')) return;
            if (status === 'completed' && !confirm('Mark as completed?')) return;
            
            const token = getAuthToken();
            const headers = { 'Content-Type': 'application/json' };
            
            // Add Authorization header if token exists
            if (token) {
                headers['Authorization'] = `Bearer ${token}`;
            }
            
            fetch(`/appointments/${id}/status`, {
                method: 'PUT',
                headers: headers,
                credentials: 'include', // Include cookies for session-based auth
                body: JSON.stringify({ status })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error updating appointment: ' + (data.error || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error updating appointment. Please try again.');
            });
        }
    </script>
</body>
</html>
``` 